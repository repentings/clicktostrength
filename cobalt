local flyEnabled = false
local noclipEnabled = false
local infiniteJumpEnabled = false
local currentFlySpeed = 50
local currentWalkSpeed = 16

-- AutoClick variables
local autoClickEnabled = false
local autoClickDelay = 0.1
local autoClickLoop = nil
local remoteEvent = nil

-- Get remote event
local function getRemoteEvent()
    if remoteEvent then return remoteEvent end
    local replicatedStorage = game:GetService("ReplicatedStorage")
    remoteEvent = replicatedStorage:FindFirstChild("Remotes") and replicatedStorage.Remotes:FindFirstChild("Events") and replicatedStorage.Remotes.Events:FindFirstChild("ClickUI")
    return remoteEvent
end

-- AutoClick loop
local function startAutoClick()
    if autoClickLoop then return end
    autoClickLoop = task.spawn(function()
        while autoClickEnabled do
            local event = getRemoteEvent()
            if event then
                -- Use FireServer (standard Roblox remote event)
                -- If the remote expects a client event, you may need to use FireClient, but given the provided code, we assume server.
                pcall(function()
                    event:FireServer(1, false)
                end)
            else
                -- If remote not found, wait and retry
                task.wait(1)
            end
            task.wait(autoClickDelay)
        end
        autoClickLoop = nil
    end)
end

local function stopAutoClick()
    if autoClickLoop then
        task.cancel(autoClickLoop)
        autoClickLoop = nil
    end
end

local function setAutoClickEnabled(enable)
    autoClickEnabled = enable
    if autoClickEnabled then
        startAutoClick()
        autoClickStatus.Text = "AutoClick: ON (clicking every " .. string.format("%.2f", autoClickDelay) .. "s)"
        autoClickStatus.TextColor3 = Color3.fromRGB(0, 200, 0)
    else
        stopAutoClick()
        autoClickStatus.Text = "AutoClick: OFF"
        autoClickStatus.TextColor3 = Color3.fromRGB(180, 180, 190)
    end
end

local function setAutoClickDelay(delay)
    autoClickDelay = math.clamp(delay, 0.05, 1.0)
    delayLabel.Text = "Click Delay: " .. string.format("%.2f", autoClickDelay) .. " sec"
    local percent = (autoClickDelay - 0.05) / (1.0 - 0.05)
    delayFill.Size = UDim2.new(percent, 0, 1, 0)
    delaySliderButton.Position = UDim2.new(percent, -8, 0.5, -8)
    if autoClickEnabled then
        -- Restart loop with new delay
        stopAutoClick()
        startAutoClick()
    end
end

-- ===================== Other Features (Fly, Noclip, etc.) =====================
local character = nil
local humanoid = nil
local rootPart = nil

local function getCharacter()
    character = player.Character
    if character and character.Parent then
        humanoid = character:FindFirstChild("Humanoid")
        rootPart = character:FindFirstChild("HumanoidRootPart")
        return true
    end
    return false
end

-- Fly implementation
local flyConnection = nil
local bodyVelocity = nil

local function startFly()
    if not getCharacter() then return end
    if flyConnection then flyConnection:Disconnect() end
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    humanoid.PlatformStand = true
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.Velocity = Vector3.new()
    bodyVelocity.Parent = rootPart
    flyConnection = runService.Heartbeat:Connect(function(dt)
        if not flyEnabled or not character or character.Parent == nil then
            if bodyVelocity then bodyVelocity:Destroy() end
            if flyConnection then flyConnection:Disconnect() end
            flyConnection = nil
            return
        end
        local moveDirection = humanoid.MoveDirection
        local camera = workspace.CurrentCamera
        local forward = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector
        local up = camera.CFrame.UpVector
        local velocity = (forward * moveDirection.Z + right * moveDirection.X) * currentFlySpeed
        if userInputService:IsKeyDown(Enum.KeyCode.Space) then
            velocity = velocity + up * currentFlySpeed
        end
        if userInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            velocity = velocity - up * currentFlySpeed
        end
        bodyVelocity.Velocity = velocity
    end)
end

local function stopFly()
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        humanoid.PlatformStand = false
    end
end

local function setFlyEnabled(enable)
    flyEnabled = enable
    if flyEnabled then
        if getCharacter() then
            startFly()
        else
            player.CharacterAdded:Connect(function(newChar)
                if flyEnabled then
                    getCharacter()
                    startFly()
                end
            end)
        end
    else
        stopFly()
    end
end

-- Noclip
local noclipConnection = nil
local function updateNoclip()
    if not noclipEnabled then return end
    if not getCharacter() then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function startNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    updateNoclip()
    noclipConnection = character.DescendantAdded:Connect(function(part)
        if noclipEnabled and part:IsA("BasePart") then
            part.CanCollide = false
        end
    end)
end

local function stopNoclip()
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    if getCharacter() then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function setNoclipEnabled(enable)
    noclipEnabled = enable
    if noclipEnabled then
        if getCharacter() then
            startNoclip()
        else
            player.CharacterAdded:Connect(function(newChar)
                if noclipEnabled then
                    getCharacter()
                    startNoclip()
                end
            end)
        end
    else
        stopNoclip()
    end
end

-- Infinite Jump
local infiniteJumpConnection = nil
local function setInfiniteJumpEnabled(enable)
    infiniteJumpEnabled = enable
    if infiniteJumpEnabled then
        if infiniteJumpConnection then infiniteJumpConnection:Disconnect() end
        infiniteJumpConnection = userInputService.JumpRequest:Connect(function()
            if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    else
        if infiniteJumpConnection then infiniteJumpConnection:Disconnect(); infiniteJumpConnection = nil end
    end
end

