-- ===================== Slider Dragging Logic =====================
local function makeDraggableSlider(sliderFrame, fillFrame, dragButton, onChange, minVal, maxVal, initialVal)
    local dragging = false
    dragButton.MouseButton1Down:Connect(function()
        dragging = true
        local mouse = player:GetMouse()
        local function update()
            local relativeX = math.clamp((mouse.X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
            local value = minVal + (maxVal - minVal) * relativeX
            onChange(value)
        end
        local conn
        conn = mouse.Move:Connect(update)
        local relConn
        relConn = userInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
                conn:Disconnect()
                relConn:Disconnect()
            end
        end)
        update()
    end)
end

