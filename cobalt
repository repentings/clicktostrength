-- AutoClick
local remoteEvent = nil
local autoClickEnabled = false
local clickDelay = 0.1
local clickLoop = nil

local function getRemote()
    if remoteEvent then return remoteEvent end
    local rep = game:GetService("ReplicatedStorage")
    remoteEvent = rep:FindFirstChild("Remotes") and rep.Remotes:FindFirstChild("Events") and rep.Remotes.Events:FindFirstChild("ClickUI")
    return remoteEvent
end

local function startAutoClick()
    if clickLoop then return end
    clickLoop = task.spawn(function()
        while autoClickEnabled do
            local ev = getRemote()
            if ev then
                pcall(function() ev:FireServer(1, false) end)
            end
            task.wait(clickDelay)
        end
        clickLoop = nil
    end)
end

local function stopAutoClick()
    if clickLoop then task.cancel(clickLoop); clickLoop = nil end
end

local function setAutoClick(enabled)
    autoClickEnabled = enabled
    if enabled then
        startAutoClick()
        statusLabel.Text = "AutoClick: ON (" .. string.format("%.2f", clickDelay) .. "s)"
        statusLabel.TextColor3 = Color3.fromRGB(0, 200, 0)
    else
        stopAutoClick()
        statusLabel.Text = "AutoClick: OFF"
        statusLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
    end
end

local function setClickDelay(delay)
    clickDelay = math.clamp(delay, 0.05, 1.0)
    delayLabel.Text = "Click Delay: " .. string.format("%.2f", clickDelay) .. " sec"
    local p = (clickDelay - 0.05) / (1.0 - 0.05)
    delayFill.Size = UDim2.new(p, 0, 1, 0)
    delaySliderBtn.Position = UDim2.new(p, -8, 0.5, -8)
    if autoClickEnabled then
        stopAutoClick()
        startAutoClick()
    end
end

-- Slider dragging
local function makeSlider(sliderFrame, fillFrame, dragBtn, onChange, minV, maxV)
    dragBtn.MouseButton1Down:Connect(function()
        local mouse = player:GetMouse()
        local moveConn, upConn
        local function update()
            local x = math.clamp((mouse.X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
            local val = minV + (maxV - minV) * x
            onChange(val)
        end
        moveConn = mouse.Move:Connect(update)
        upConn = uis.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                moveConn:Disconnect()
                upConn:Disconnect()
            end
        end)
        update()
    end)
end

