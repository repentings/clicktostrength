-- ------------------------------ Features ------------------------------
local char, hum, root
local flyEnabled = false
local noclipEnabled = false
local infJumpEnabled = false
local flySpeed = 50
local walkSpeed = 16

local flyConn = nil
local bodyVel = nil
local noclipConn = nil
local infJumpConn = nil

local function getChar()
    char = player.Character
    if char and char.Parent then
        hum = char:FindFirstChild("Humanoid")
        root = char:FindFirstChild("HumanoidRootPart")
        return true
    end
    return false
end

-- Fly
local function startFly()
    if not getChar() then return end
    if flyConn then flyConn:Disconnect() end
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    hum.PlatformStand = true
    bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVel.Parent = root
    flyConn = rs.Heartbeat:Connect(function()
        if not flyEnabled or not char or not char.Parent then
            if bodyVel then bodyVel:Destroy() end
            if flyConn then flyConn:Disconnect() end
            flyConn = nil
            return
        end
        local move = hum.MoveDirection
        local cam = workspace.CurrentCamera
        local f = cam.CFrame.LookVector
        local r = cam.CFrame.RightVector
        local u = cam.CFrame.UpVector
        local vel = (f * move.Z + r * move.X) * flySpeed
        if uis:IsKeyDown(Enum.KeyCode.Space) then vel = vel + u * flySpeed end
        if uis:IsKeyDown(Enum.KeyCode.LeftControl) then vel = vel - u * flySpeed end
        bodyVel.Velocity = vel
    end)
end

local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if bodyVel then bodyVel:Destroy(); bodyVel = nil end
    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        hum.PlatformStand = false
    end
end

local function setFly(enabled)
    flyEnabled = enabled
    if flyEnabled then
        if getChar() then startFly()
        else player.CharacterAdded:Connect(function() if flyEnabled then getChar(); startFly() end end)
        end
    else stopFly() end
end

-- Noclip
local function updateNoclip()
    if not noclipEnabled or not getChar() then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
end

local function startNoclip()
    if noclipConn then noclipConn:Disconnect() end
    updateNoclip()
    noclipConn = char.DescendantAdded:Connect(function(part)
        if noclipEnabled and part:IsA("BasePart") then part.CanCollide = false end
    end)
end

local function stopNoclip()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if getChar() then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

local function setNoclip(enabled)
    noclipEnabled = enabled
    if noclipEnabled then
        if getChar() then startNoclip()
        else player.CharacterAdded:Connect(function() if noclipEnabled then getChar(); startNoclip() end end)
        end
    else stopNoclip() end
end

-- Infinite Jump
local function setInfJump(enabled)
    infJumpEnabled = enabled
    if infJumpConn then infJumpConn:Disconnect(); infJumpConn = nil end
    if enabled then
        infJumpConn = uis.JumpRequest:Connect(function()
            if hum and hum:GetState() ~= Enum.HumanoidStateType.Jumping then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

