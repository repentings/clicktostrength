local function openURL(url)
    local success = false
    if syn and syn.request then
        syn.request({ Url = url, Method = "GET" })
        success = true
    elseif http and http.request then
        http.request(url)
        success = true
    elseif setclipboard then
        setclipboard(url)
        success = true
    end
    if not success then
        warn("Open this link: " .. url)
    end
end

